@page "/"

<PageTitle>DataArc Orchestration Demo</PageTitle>

<div class="container-fluid px-0">

    <section class="mb-5">
        <div class="p-4 p-lg-5 rounded-3 border bg-body-tertiary">
            <div class="row align-items-center g-4">

                <div class="col-lg-8">
                    <h1 class="display-4 fw-semibold mb-3">
                        Clean Architecture Application
                    </h1>

                    <p class="lead mb-3">
                        Application Orchestration using DataArc.OrchestrationFramework for modular .NET systems.
                    </p>

                    <p class="mb-4">
                        This demo shows how DataArc coordinates application workflows,
                        policies, events and persistence across multiple EF Core
                        <code>DbContext</code> boundaries while remaining inside the
                        application process.
                    </p>
                    
                </div>

                <div class="col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h2 class="h5">Core idea</h2>

                            <p class="mb-0">
                                A <code>DbContext</code> boundary does not have to become
                                a relational boundary.
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <section class="mb-5">
        <h2 class="mb-3">Two kinds of orchestration</h2>

        <div class="row g-4">

            <div class="col-lg-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="h4">.NET Aspire</h3>

                        <p>
                            Aspire orchestrates the applications and development environment.
                        </p>

                        <ul class="mb-0">
                            <li>Application hosting</li>
                            <li>Service discovery</li>
                            <li>Health checks</li>
                            <li>Logs</li>
                            <li>Metrics</li>
                            <li>Distributed tracing</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="h4">DataArc</h3>

                        <p>
                            DataArc orchestrates work inside the application process.
                        </p>

                        <ul class="mb-0">
                            <li>Application workflows</li>
                            <li>Policies</li>
                            <li>Events</li>
                            <li>Cross-module coordination</li>
                            <li>Multi-DbContext persistence</li>
                            <li>Transactional execution</li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <section class="mb-5">
        <h2 class="mb-3">Solution architecture</h2>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <img src="@Assets["images/Architecture.png"]"
                             alt="DataArc Orchestration With Clean Architecture"
                             class="img-fluid" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="mb-5">
        <h2 class="mb-3">Application boundaries</h2>

        <div class="row g-4">

            <div class="col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">Presentation</h3>
                        <p class="mb-0">
                            Razor Components and ASP.NET Core Web API expose the demo
                            workflows without owning orchestration logic.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">Application</h3>
                        <p class="mb-0">
                            Policies, events and orchestration coordinate application
                            behavior while remaining independent of persistence details.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">Persistence</h3>
                        <p class="mb-0">
                            Multiple EF Core contexts preserve module boundaries while
                            participating in one relational SQL Server model.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <section class="mb-5">
        <h2 class="mb-3">Composed relational model</h2>

        <p>
            ASP.NET Core Identity and four business contexts participate in one
            physical relational database with schema ownership and database-enforced
            foreign-key relationships.
        </p>

        <div class="card shadow-sm">
            <div class="card-body">
                <img src="@Assets["images/ERD.png"]"
                     alt="DataArc Orchestration Demo database model"
                     class="img-fluid" />
            </div>
        </div>
    </section>

    <section class="mb-5">
        <h2 class="mb-3">What this demo demonstrates</h2>

        <div class="row g-4">

            <div class="col-md-6 col-xl-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">Modular DbContexts</h3>
                        <p class="mb-0">
                            HR, Finance, IT, Operations and Identity remain separate
                            application boundaries.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">Relational Integrity</h3>
                        <p class="mb-0">
                            Cross-context foreign keys and schema relationships are
                            enforced by SQL Server.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">Fast Data Operations</h3>
                        <p class="mb-0">
                            Import large employee datasets through DataArc's EF Core
                            bulk execution path.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h3 class="h5">Application Orchestration</h3>
                        <p class="mb-0">
                            Coordinate HR, Finance, IT and Operations through one
                            explicit onboarding workflow.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <section class="pb-4">
        <div class="border-top pt-4 d-flex flex-column flex-lg-row justify-content-between gap-3">

            <div>
                <strong>Solid Arc Software</strong>
                <div class="text-body-secondary small">
                    Strategize. Observe. Adapt. Provide.
                </div>
            </div>

            <div class="text-body-secondary small align-self-lg-end">
                Real application boundaries. One relational model. Explicit orchestration.
            </div>

        </div>
    </section>

</div>